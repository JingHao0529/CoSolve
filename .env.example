# Example values only. Put real values in Replit Secrets or your shell environment.
# Neither the Node scripts nor app.py automatically loads this file.

# Replit Express backend (use a separate PORT for the frontend workflow).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PORT=5000
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# React/Vite frontend workflow: set PORT=5173 and BASE_PATH=/ for that process.
# VITE_* values are public browser configuration. Never put service secrets here.
BASE_PATH=/
VITE_CLERK_PUBLISHABLE_KEY=
# VITE_CLERK_PROXY_URL=

# Replit backend -> existing custom RunPod sentiment HTTP service.
RUNPOD_API_KEY=
COSOLVE_SENTIMENT_URL=https://YOUR_ENDPOINT_ID.api.runpod.ai
COSOLVE_API_KEY=

# RunPod worker only: preserve your existing Network Volume mount and model path.
COSOLVE_MODEL_DIR=/runpod-volume/artifacts/sentiment-distilbert-v1/model
# Python service uses PORT=80 unless explicitly overridden; do not use backend PORT=5000 there.

# Separate language-model assistance (Replit backend only).
GRAFILAB_API_KEY=
GRAFILAB_CHAT_MODEL=grafilab/deepseek-v4-flash

# Alternative OpenAI-compatible RunPod mode only; leave unset for the custom service above.
# RUNPOD_BASE_URL=https://api.runpod.ai/v2/YOUR_ENDPOINT_ID/openai/v1
# RUNPOD_ENDPOINT_ID=
# RUNPOD_MODEL=

# Optional WhatsApp webhook, only if you configure that integration.
# META_WHATSAPP_APP_SECRET=
# META_WHATSAPP_VERIFY_TOKEN=
